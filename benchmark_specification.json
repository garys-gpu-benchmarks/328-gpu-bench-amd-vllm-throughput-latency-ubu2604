  {
    "field_name": "Raw Output Example",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sample_index,status,output_token_throughput_tokens_s,tokens_per_sec,time_to_first_token_p50_ms,ttft_p50_ms,time_per_output_token_p50_ms,tpot_p50_ms,inter_token_latency_itl_p50_ms,itl_p50_ms,end_to_end_request_latency_ms,e2e_ms,output_token_throughput_tokens_sec,ttft_p50_msec,time_per_output_token_tpot_p50_msec,inter_token_latency_itl_p50_msec,end_to_end_request_latency_msec,error_message\n0,ok,80,80,20,20,15,15,14,14,200,200,80,20,15,14,200,"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --model-name mistralai/Mistral-7B-v0.3 --dtype bfloat16 --tensor-parallel-size 1 --gpu-memory-utilization 0.9 --prompt-source synthetic --input-len 64 --output-len 16 --max-num-seqs 2 --max-concurrency 2"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --model-name mistralai/Mistral-7B-v0.3 --dtype bfloat16 --tensor-parallel-size 1 --gpu-memory-utilization 0.9 --prompt-source synthetic --input-len 512 --output-len 13320 --max-num-seqs 8 --max-concurrency 8"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --model-name mistralai/Mistral-7B-v0.3 --dtype bfloat16 --tensor-parallel-size 1 --gpu-memory-utilization 0.9 --prompt-source synthetic --input-len 1024 --output-len 16500 --max-num-seqs 16 --max-concurrency 8"
  },
  {
    "field_name": "Output Fields / Metrics to Parse",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "output_token_throughput_tokens_sec, ttft_p50_msec, time_per_output_token_tpot_p50_msec, inter_token_latency_itl_p50_msec, end_to_end_request_latency_msec. The same p50 values are also written as output_token_throughput_tokens_s, ttft_p50_ms, tpot_p50_ms, itl_p50_ms, end_to_end_request_latency_ms"
  },
  {
    "field_name": "Success Criteria",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "status=ok and throughput, TTFT, TPOT, and end-to-end latency are finite"
  },
  {
    "field_name": "Parser and Normalization Notes",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Parse raw_results.csv. Requests are streamed: TTFT is time to the first token chunk; TPOT = (E2E - TTFT) / (output tokens - 1), using usage.completion_tokens from stream_options.include_usage; ITL p50 is over every inter-token gap. Column names that say p50_p95_p99 hold p50 only, including end_to_end_request_latency_ms. The summary is written twice"
  },
